DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=tienda.example.com
CORS_ALLOWED_ORIGINS=https://tienda.example.com
CSRF_TRUSTED_ORIGINS=https://tienda.example.com

POSTGRES_DB=estelart_db
POSTGRES_USER=estelart_user
POSTGRES_PASSWORD=replace-with-a-long-random-password

APP_PORT=8080
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
